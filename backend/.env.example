# Local database from docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://outfit:outfit@127.0.0.1:5433/outfit

# Signs the access tokens. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Comma-separated OAuth client IDs accepted as audience of the ID tokens.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Garment photos, one folder per user.
STORAGE_DIR=storage

# AI models, all through OpenRouter.
OPENROUTER_API_KEY=
VISION_MODEL=google/gemini-3.1-flash-lite
IMAGE_MODEL=bytedance-seed/seedream-5-0-flash
OUTFIT_MODEL=google/gemini-3.1-flash-lite
